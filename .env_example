GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=clave_generada_sin_espacios

set OLLAMA_GPU_OVERHEAD=0
set OLLAMA_NUM_PARALLEL=1
ollama serve

# Elige el modelo aquí. Cambia esta línea y vuelve a ejecutar.
# OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_MODEL=qwen2.5:1.5b

# Opcional — ajustes finos
HOURS_TO_FETCH=48
CPU_THREADS=4
CONTEXT_SIZE=512
NUM_PREDICT=180
OLLAMA_TIMEOUT=180
